# Copie para .env e substitua a senha antes de subir os serviços.
POSTGRES_DB=separador_materiais
POSTGRES_USER=separador
POSTGRES_PASSWORD=troque-esta-senha
# Use 5433 se já houver PostgreSQL instalado na porta 5432.
POSTGRES_PORT=5432
# Para testes na rede local, use 0.0.0.0 e acesse http://IP-DO-PC:8080.
WEB_BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:5173
INSTALL_OCR=true
INSTALL_DOCLING=false
# Para execução fora do Docker, configure no ambiente:
# DATABASE_URL=postgresql+psycopg://separador:SENHA@localhost:5432/separador_materiais
