# Conexão ao PostgreSQL (opcional).
#
# Só precisa deste arquivo se o seu banco NÃO for o do docker-compose
# (localhost:5432, usuário postgres, senha postgres, banco separador_materiais).
#
# Como usar: copie para  .streamlit/secrets.toml  e ajuste os valores.
# Alternativa: defina as variáveis de ambiente DATABASE_URL ou PGHOST/PGPORT/
# PGUSER/PGPASSWORD/PGDATABASE antes de rodar o app.

# --- Opção A: URL única (tem prioridade sobre a seção [postgres]) ---
# DATABASE_URL = "postgresql://usuario:senha@host:5432/separador_materiais"

# --- Opção B: por partes ---
[postgres]
host = "localhost"
port = 5432
user = "postgres"
password = "postgres"
dbname = "separador_materiais"
